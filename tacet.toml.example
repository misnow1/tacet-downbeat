# tacet-downbeat site config -- copy to tacet.toml and fill in.
#
#     cp tacet.toml.example tacet.toml
#
# tacet.toml is gitignored. The console IP, the DCA number and the NAS path are
# site values and stay out of the repo; docs/gameday.md is where they are
# written down. This file is the shape, not the values.
#
# Everything here is optional. Every key but [interfaces] has a flag that
# overrides it:
#
#     built-in default  <  this file  <  the flag on the command line
#
# [interfaces] has no flags: a MAC address is a site fact, not something to
# retype on the day.
#
# Found in this order, and the tool prints which one it used:
#
#     1. --config PATH
#     2. $TACET_CONFIG
#     3. ./tacet.toml
#     4. ~/.config/tacet/tacet.toml
#
# An unknown key here is an error rather than a shrug, so a config that is
# spelled wrong stops the tool instead of quietly driving the wrong fader.

# The DM7. Read by tacet-serve and by verify_dm7.
[console]
# Setup > Network > For Mixer Control on the console.
host = "10.0.0.5"           # --console-host  (verify_dm7: --host); IPv4 only, never a name (#71)
port = 49900                # --console-port  (verify_dm7: --port)
# The band DCA. Getting this wrong rides somebody else's fader.
dca = 3                     # --dca

# Leave false until verify_dm7 --granularity has shown the console rounds.
# Override on the day with --quantized / --no-quantized.
quantized = false

# Reaper. Read by tacet-serve and by verify_reaper.
[reaper]
# Reaper and the box share a machine for now.
host = "127.0.0.1"          # --reaper-host   (verify_reaper: --host); IPv4 only, never a name (#71)
send_port = 8000            # --reaper-port   -- Reaper's "local listen port"
receive_port = 9000         # --reaper-feedback-port -- Reaper's "device port"

# Where the game is written down.
[capture]
# There is no `log` key. The log changes every game, so it is always passed as
# --log ~/games/<YYYY-MM-DD>.jsonl on the command line, and a file still
# carrying `log = ...` refuses to load.
#
# Stable, and must match the path the ReaScript watches. Mismatching this is the
# single most common way to have everything look healthy and mirror nothing.
queue = "~/Library/Application Support/REAPER/tacet/queue.tsv"
#
# Where Reaper records: the NAS share, mounted. The box refuses to start without
# room for a whole game there, or if the path is not there at all - which is
# what an unmounted share looks like. --no-disk-check (a flag, never a key)
# starts it anyway.
audio_path = "/Volumes/band"  # --audio-path
# Tracks this game records. Changes with the patch list, so check it each game;
# the page's tracks chip says when Reaper disagrees.
channels = 22               # --channels
game_hours = 5.0            # --game-hours

[fader]
# The close fade. Asymmetric by design: fast open, slow close.
fade_seconds = 2.0          # --fade

# The ride-in for the "up slow" button, used when the first phrase was
# missed and a snap open would be audible under a phrase already going.
# Tapered: fast through the bottom, slow through the top. This sets the
# length; the shape is fixed. The other two open buttons still snap.
slow_open_seconds = 1.5     # --slow-open

# READY: something good happened for the home team, the fader rides to a hold
# level short of target and waits to see whether the band starts (#6). The
# hold level is an offset below target, not an absolute level, so it follows
# whatever preset is in force rather than meaning less as the target moves.
hold_below_db = 15.0        # --hold-below-db
ready_ride_seconds = 4.0    # --ready-ride

# Changing the target in MORE while the fader is up rides it to the new level
# (or the READY hold to the new hold) over this long, on the ride-in taper (#128).
retarget_ride_seconds = 1.0  # --retarget-ride

# A fader tap that reaches the box later than this is logged and not executed:
# a late open brings the PA up after the music stopped, a late fade cuts a
# phrase. Generous, because the page's clock estimate is approximate. Retune
# from the per-tap delays game 3 logs. Annotations are never refused.
stale_tap_seconds = 2.0     # --stale-tap

# The target levels the page offers on MORE > Target level (#9), in dB, in the
# order the page lists them: the FIRST is the default unless default_target_db
# below names another. The open buttons go to the default until the operator
# picks another, and the page's readout goes amber when the target is not
# this one. A site that rings out to -2 dB writes [-2.0, -5.0, -8.0] and
# either sets default_target_db = -2.0 below or deletes that key and lets
# the first entry serve.
presets = [0.0, -3.0, -6.0]  # --presets 0,-3,-6  (--presets=-3,-6 if it starts with a minus)

# The default: the level the open buttons go to until the operator picks
# another, and the one the page's readout is neutral at - amber means "not
# this". Optional; leave it out and the FIRST preset is the default, which is
# what every box did before #139. It must be one of the presets above or the
# box refuses to start: the page offers presets only, so a default outside the
# list is a level the operator cannot choose again. Order the list by level and
# name the default here - 0 dB most games, +3 dB for a very loud crowd.
default_target_db = 0.0     # --default-target

# The cap on every preset: one above it refuses at load, in the file and as a
# flag alike, so a level nobody has rung out cannot exist by accident. +3 dB
# costs 3 dB of feedback margin against the band PA behind the mics, so this
# ships at 0 dB and is raised only after an on-site ring-out with the stands
# empty. Anything the operator taps is one of the presets, never an
# arbitrary value.
max_target_db = 0.0         # --max-target

# The box's own network adapters, by role (#234). Optional: leave the section
# out and the box checks nothing, and the banner and the page say so. There is
# no flag for these.
#
# A role is a MAC address. These are documentation placeholders (RFC 7042):
# replace each with the real one from
#
#     networksetup -listallhardwareports
#
# (the "Ethernet Address" under the adapter's Hardware Port). A copied example
# reads MISSING on the day, which is the point: the box says so rather than
# checking nothing. Names such as en7 are never used, since macOS renumbers a
# USB adapter when it is replugged; the MAC does not change.
#
# A role that rides a VLAN is a table, { mac = "...", vlan = N }: the VLAN
# interface with that tag on the adapter with that MAC, whatever macOS calls it
# (vlan0). A VLAN interface shares its parent's MAC, so the same MAC may be
# named twice only with different tags. The 20 below is a placeholder too:
# use the tag the scoreboard VLAN really has.
[interfaces]
# Dante: present with a link is enough. No address is needed.
dante = "00:00:5e:00:53:02"
# The control VLAN's adapter: a link and a real IPv4 address (a 169.254 address
# does not count).
control = "00:00:5e:00:53:01"
# The scoreboard's RTD stream arrives on the control adapter, on another VLAN.
scoring = { mac = "00:00:5e:00:53:01", vlan = 20 }

# The scoreboard's RTD feed, read for the game clock on the page (#235). Display
# only: it is never a gate on the fader. The box listens on every address, since
# the board broadcasts to 255.255.255.255 and a socket bound to one address is
# not delivered a broadcast; there is no key for that, and none to turn it off.
[rtd]
port = 21000                # --rtd-port

# The operator page.
[ui]
# 0.0.0.0 or the iPad cannot reach it. 127.0.0.1 serves this machine only,
# which looks exactly like a firewall problem.
listen = "0.0.0.0"          # --listen
port = 8080                 # --http-port
