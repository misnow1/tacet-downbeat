# tacet-downbeat site config -- copy to tacet.toml and fill in.
#
#     cp tacet.toml.example tacet.toml
#
# tacet.toml is gitignored. The console IP, the DCA number and the NAS path are
# site values and stay out of the repo; docs/gameday.md is where they are
# written down. This file is the shape, not the values.
#
# Everything here is optional, and every key has a flag that overrides it:
#
#     built-in default  <  this file  <  the flag on the command line
#
# Found in this order, and the tool prints which one it used:
#
#     1. --config PATH
#     2. $TACET_CONFIG
#     3. ./tacet.toml
#     4. ~/.config/tacet/tacet.toml
#
# An unknown key here is an error rather than a shrug, so a config that is
# spelled wrong stops the tool instead of quietly driving the wrong fader.

# The DM7. Read by tacet-serve and by verify_dm7.
[console]
# Setup > Network > For Mixer Control on the console.
host = "10.0.0.5"           # --console-host  (verify_dm7: --host)
port = 49900                # --console-port  (verify_dm7: --port)
# The band DCA. Getting this wrong rides somebody else's fader.
dca = 3                     # --dca
# Leave false until verify_dm7 --granularity has shown the console rounds.
# Override on the day with --quantized / --no-quantized.
quantized = false

# Reaper. Read by tacet-serve and by verify_reaper.
[reaper]
# Reaper and the box share a machine for now.
host = "127.0.0.1"          # --reaper-host   (verify_reaper: --host)
send_port = 8000            # --reaper-port   -- Reaper's "local listen port"
receive_port = 9000         # --reaper-feedback-port -- Reaper's "device port"

# Where the game is written down.
[capture]
# There is no `log` key. The log changes every game, so it is always passed as
# --log ~/games/<YYYY-MM-DD>.jsonl on the command line, and a file still
# carrying `log = ...` refuses to load.
#
# Stable, and must match the path the ReaScript watches. Mismatching this is the
# single most common way to have everything look healthy and mirror nothing.
queue = "~/Library/Application Support/REAPER/tacet/queue.tsv"
#
# Where Reaper records: the NAS share, mounted. The box refuses to start without
# room for a whole game there, or if the path is not there at all - which is
# what an unmounted share looks like. --no-disk-check (a flag, never a key)
# starts it anyway.
audio_path = "/Volumes/band"  # --audio-path
# Tracks this game records. Changes with the patch list, so check it each game.
channels = 22               # --channels
game_hours = 5.0            # --game-hours

[fader]
# The close fade. Asymmetric by design: fast open, slow close.
fade_seconds = 2.0          # --fade
# The ride-in for the "up slow" button, used when the first phrase was
# missed and a snap open would be audible under a phrase already going.
# Tapered: fast through the bottom, slow through the top. This sets the
# length; the shape is fixed. The other two open buttons still snap.
slow_open_seconds = 1.5     # --slow-open
# READY: something good happened for the home team, the fader rides to a hold
# level short of target and waits to see whether the band starts (#6). The
# hold level is an offset below target, not an absolute level, so it follows
# whatever preset is in force rather than meaning less as the target moves.
hold_below_db = 15.0        # --hold-below-db
ready_ride_seconds = 4.0    # --ready-ride
# A fader tap that reaches the box later than this is logged and not executed:
# a late open brings the PA up after the music stopped, a late fade cuts a
# phrase. Generous, because the page's clock estimate is approximate. Retune
# from the per-tap delays game 3 logs. Annotations are never refused.
stale_tap_seconds = 2.0     # --stale-tap

# The operator page.
[ui]
# 0.0.0.0 or the iPad cannot reach it. 127.0.0.1 serves this machine only,
# which looks exactly like a firewall problem.
listen = "0.0.0.0"          # --listen
port = 8080                 # --http-port
